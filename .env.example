# 복사해서 .env로 저장하고 실제 값을 채우세요: cp .env.example .env
PORT=8124
NODE_ENV=production

# n8n 백엔드(스크립트 생성/로컬LLM/임베딩 웹훅)가 검사하는 공유 비밀 키.
# n8n 워크플로 쪽 IF 노드에 설정된 값과 동일해야 함. 코드에는 절대 하드코딩하지 마세요.
N8N_KEY=

# n8n 인스턴스 주소 (기본값: 로컬 n8n)
N8N_BASE=http://127.0.0.1:5680

# 최초 설치 시 admin 계정 비밀번호. 비워두면 서버가 무작위로 생성해서 시작 로그에 한 번만 찍어줍니다.
ADMIN_SEED_PASSWORD=
